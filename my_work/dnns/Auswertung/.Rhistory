# Horizontal benchmark line
geom_hline(yintercept = 1/3, colour = "black", size = 1, linetype = "dashed") +
scale_color_manual(
values = c(
"Training" = "#1f77b4",       # Blue
"Testing" = "#ff7f0e",        # Orange
"Train Trend" = "#1f77b4",
"Test Trend" = "#ff7f0e"
),
name = "Legend"
) +
scale_shape_manual(
values = c("Training Avg" = 17, "Testing Avg" = 18),
name = "Legend"
) +
theme_minimal(base_size = 14) +
labs(
title = paste0("Architecture: ", model_name),
x = "Epoch",
y = "Accuracy"
) +
scale_y_continuous(expand = c(0, 0), limits = c(0, 1.1)) +
theme(
legend.position = "bottom",
legend.box = "horizontal",
panel.grid.minor = element_blank()
)
}
)
